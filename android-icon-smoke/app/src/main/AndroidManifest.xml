        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
       </intent-filter>
    </activity-alias>
    <activity-alias android:name=".LauncherLegacyGraphiteSquare"
        android:targetActivity=".MainActivity" android:exported="true"
        android:label="enoTone G square"
        android:icon="@mipmap/legacy_graphite_square">
       <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
