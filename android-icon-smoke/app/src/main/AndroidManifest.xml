        android:targetActivity=".MainActivity" android:exported="true"
        android:label="enoTone adaptive G"
        android:icon="@mipmap/adaptive_graphite">
       <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
       </intent-filter>
    </activity-alias>
    <activity-alias android:name=".LauncherAdaptivePorcelain"
        android:targetActivity=".MainActivity" android:exported="true"
